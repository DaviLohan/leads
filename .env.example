# Copie para .env e ajuste. O .env NUNCA é versionado.
# Os valores abaixo funcionam em desenvolvimento local.

# --- Django ---
# Em produção é obrigatória e não pode ser este valor (a aplicação recusa iniciar).
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_LOG_LEVEL=INFO

# --- Banco ---
POSTGRES_DB=leads
POSTGRES_USER=leads
POSTGRES_PASSWORD=leads
POSTGRES_PORT=5432
DATABASE_URL=postgis://leads:leads@db:5432/leads

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_CONCURRENCY=2

# --- Portas expostas no host ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- CORS / CSRF ---
# Em produção: origens exatas, separadas por vírgula. Nunca "*".
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Observabilidade (opcional) ---
SENTRY_DSN=

# --- Providers externos ---
# Endpoint configurável: o público é comunitário e tem política de uso justo (ver ADR-0004).
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_RATE_LIMIT_PER_SECOND=1
# User-Agent identificando a aplicação, exigido pela política de uso do OSM.
OVERPASS_USER_AGENT=leads-radar/0.1 (contato: informatica@formedica.com.br)

# --- IA (opcional; a plataforma funciona sem nenhuma configurada) ---
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Produção (não usar em dev) ---
GUNICORN_WORKERS=3
